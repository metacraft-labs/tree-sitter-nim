root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript (grammar.js)
[*.js]
indent_size = 2

# C source files (generated)
[*.{c,h}]
indent_size = 4

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Justfile
[Justfile]
indent_style = space
indent_size = 4

# Tree-sitter test files
[*.txt]
indent_size = 2
trim_trailing_whitespace = false

# Scheme files (queries)
[*.scm]
indent_size = 2
